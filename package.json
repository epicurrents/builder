{
    "name": "epicurrents-app",
    "version": "0.1.0",
    "description": "Epicurrents application",
    "main": "index.js",
    "scripts": {
        "build:app": "cd interface && npm run build:app",
        "build:asset": "node scripts/build.mjs",
        "build:assets": "node scripts/build.mjs util interface epicurrents",
        "build:tsc-all": "npm run build -w scoped-event-log -w scoped-event-bus -w asymmetric-io-mutex && npm run build:tsc --workspaces --if-present",
        "build:dev": "npm run build:assets && npm run build:ohif:dev && npm run copy:all && cd interface && npm run build:app",
        "build:edition": "npm run build:edition:lib && node scripts/standalone.mjs",
        "build:edition:lib": "vite build --config vite.config.lib.ts",
        "build:release": "npm run build:edition && node scripts/manifest.mjs",
        "build:lib": "cd interface && npm run build",
        "build:ohif:dev": "cd ohif && cross-env PUBLIC_URL=/ohif/ yarn run build && cd .. && npm run copy:ohif && node scripts/convert.mjs ohif",
        "clean": "node scripts/clean.mjs",
        "copy:all": "node scripts/copy.mjs",
        "copy:ohif": "node scripts/copy.mjs ohif",
        "copy:workers": "node scripts/copy.mjs workers",
        "instl": "node scripts/install.mjs",
        "preview": "cd interface && npm run preview",
        "setup": "node scripts/setup.mjs",
        "start": "npm run copy:workers && cd interface && npm run dev",
        "update": "node scripts/update.mjs",
        "test": "npm run test --workspaces --if-present",
        "test:core": "cd epicurrents/core && vitest run --coverage",
        "test:eeg": "cd epicurrents/eeg-module && vitest run --coverage",
        "test:tab": "cd epicurrents/tab-module && vitest run --coverage",
        "typecheck": "node scripts/typecheck.mjs"
    },
    "keywords": [],
    "author": "Sampsa Lohi",
    "license": "Apache-2.0",
    "engines": {
        "node": ">=22.12.0"
    },
    "workspaces": [
        "util/*",
        "epicurrents/*",
        "interface"
    ],
    "devDependencies": {
        "@vitest/coverage-v8": "^4.1.5",
        "cross-env": "^7.0.3",
        "jsdom": "^29.1.1",
        "vitest": "^4.1.5"
    }
}
